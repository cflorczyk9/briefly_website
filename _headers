# Netlify production response headers. Every path gets the same hardening set.
# CSP here is frame-ancestors only (clickjacking). A full resource CSP needs a
# tested allowlist for gtag, Google Fonts, and Formspree before it ships.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: frame-ancestors 'none'

# Browser caching. CSS and JS file names are not versioned, so they get one
# hour. Images change rarely, so they get a week.
/assets/*
  Cache-Control: public, max-age=3600
/images/*
  Cache-Control: public, max-age=604800
